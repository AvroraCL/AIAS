{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIAS",
  "version": "5.4.8",
  "identifier": "studio.avroracl.aias",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIAS",
        "width": 1320,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 680,
        "visible": false,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NTZFNkQ1NzZFMTYwMwpSV1FERm01WGJXNlZDYVNGanhyeTNUY0UyOGVhVjZMT2xka0FJRlFnSXVaSGVUSXdMazRoZHFmQwo=",
      "endpoints": [
        "https://github.com/AvroraCL/AIAS/releases/latest/download/latest.json",
        "https://gitcode.com/HelenaSG/Aias/releases/download/stable/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/WebView2Loader.dll": "."
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/installer-header.bmp"
      }
    }
  }
}
