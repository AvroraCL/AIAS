{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIAS",
  "version": "5.5.6",
  "identifier": "studio.avroracl.aias",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "node scripts/build-bake-worker.cjs && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIAS",
        "width": 1320,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 680,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NTZFNkQ1NzZFMTYwMwpSV1FERm01WGJXNlZDYVNGanhyeTNUY0UyOGVhVjZMT2xka0FJRlFnSXVaSGVUSXdMazRoZHFmQwo=",
      "endpoints": [
        "https://github.com/AvroraCL/AIAS/releases/latest/download/latest.json",
        "https://gitcode.com/HelenaSG/Aias/releases/download/stable/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/bake/aias-bake-worker.exe": "bake/aias-bake-worker.exe",
      "../build/bake/oidn/OpenImageDenoise.dll": "bake/oidn/OpenImageDenoise.dll",
      "../build/bake/oidn/OpenImageDenoise_core.dll": "bake/oidn/OpenImageDenoise_core.dll",
      "../build/bake/oidn/OpenImageDenoise_device_cpu.dll": "bake/oidn/OpenImageDenoise_device_cpu.dll",
      "../build/bake/oidn/tbb12.dll": "bake/oidn/tbb12.dll",
      "target/release/WebView2Loader.dll": "."
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/installer-header.bmp"
      }
    }
  }
}
